# Primary submission: OpenHands SDK + MCP stdio (no external server needed).
# Prompt: prompts/system.j2 — full MCP tool workflow (resolve_numeric_evidence, get_period_series, etc.)

name: "officeqa-openhands-stdio"
version: "5.0.0"
competition: "grounded-reasoning"

agent:
  type: "harness"
  harness_name: "openhands-sdk"
  model: "openrouter/minimax/minimax-m2.5"
  prompt_template_path: "prompts/system.j2"

  mcp_servers:
    - name: officeqa-arena
      transport: stdio
      command: /installed-agent/run_mcp.sh

  config:
    temperature: 0.0
    max_iterations: 15

  env:
    LLM_API_KEY: "REDACTED"
    OPENROUTER_API_KEY: "REDACTED"
    OFFICEQA_SQLITE_DB: ""
    OPENHANDS_SUPPRESS_BANNER: "1"
    TELEMETRY_SOURCE: "openhands"
    PYTHONPATH: "/installed-agent/overrides"

environment:
  timeout_per_task: 300
