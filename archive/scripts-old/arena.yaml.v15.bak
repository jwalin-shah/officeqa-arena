name: officeqa-v15
version: 20.1.0
competition: grounded-reasoning

agent:
  type: harness
  harness_name: goose
  model: openrouter/minimax/minimax-m2.5
  prompt_template_path: v15/prompts/prompt_b.j2

  config:
    max_turns: 40

  mcp_servers:
    - name: officeqa_mcp
      transport: stdio
      command: uvx
      args:
        - --from
        - officeqa-mcp
        - officeqa-mcp

environment:
  timeout_per_task: 480
