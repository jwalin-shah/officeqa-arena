# OfficeQA Arena — environment variables
# Copy to .env and fill in your values:  cp .env.example .env

# ── LLM (OpenRouter) ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ── Daytona sandboxes ─────────────────────────────────────────────
# Get your key at https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
DAYTONA_TARGET=us

# ── Corpus DB ─────────────────────────────────────────────────────
# Local path (auto-detected if in data/ or /app/corpus/)
# OFFICEQA_SQLITE_DB=/Users/you/projects/officeqa-arena/data/officeqa_corpus.sqlite3

# ── Droplet (for Arena CLI submissions) ───────────────────────────
DROPLET_HOST=root@157.245.243.14
ARENA_BIN=/root/.arena/venv/bin/arena

# ── Sentient Arena ────────────────────────────────────────────────
# Session token from browser (scripts/login_and_save_state.py refreshes this)
# SENTIENT_SESSION_TOKEN=
